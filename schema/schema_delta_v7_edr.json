{
 "_meta": {
  "source": "Data Schema - Draft v7 and Requirements Prompt v24 (12 Oct 2026), section 6.20",
  "applies_after": "schema_delta_R15_R18.json",
  "status": "proposed, not yet applied to generated type schemas"
 },
 "registers": {
  "add": {
   "DOCKIND": [
    "EDR"
   ],
   "LISTATE": [
    "Kept",
    "Broken"
   ]
  },
  "extend": {
   "BASIS": [
    "Inherited via EDR Sub-system tag",
    "Inherited via Sub-system Design Type"
   ],
   "PAGETYPE": [
    "EDR",
    "TSM"
   ]
  }
 },
 "new_types": {
  "Requirement Document": {
   "required": [
    "doc_kind",
    "doc_code",
    "issue",
    "sub_system_tags",
    "product_scope",
    "status"
   ],
   "properties": {
    "doc_kind": {
     "type": "string",
     "description": "reg(DOCKIND); EDR"
    },
    "doc_code": {
     "type": "string",
     "description": "Unique within the project, e.g. EDR-FUE"
    },
    "issue": {
     "type": "integer",
     "minimum": 1
    },
    "sub_system_tags": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "description": "reg(SUB)"
     },
     "description": "Many-to-many document-level Sub-system tag (6B.2)"
    },
    "issue_changes": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "issue": {
        "type": "integer"
       },
       "changed": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "added": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "removed": {
        "type": "array",
        "items": {
         "type": "string"
        }
       }
      }
     },
     "description": "Only changed line items are re-flagged (6B.10)"
    },
    "product_scope": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string"
     }
    },
    "status": {
     "enum": [
      "Draft",
      "Released",
      "Superseded",
      "Withdrawn"
     ]
    }
   }
  },
  "Line-item Review": {
   "required": [
    "fdps",
    "line_item",
    "line_item_revision",
    "state",
    "bases",
    "status"
   ],
   "properties": {
    "fdps": {
     "type": "string",
     "description": "ref(FDPS)"
    },
    "line_item": {
     "type": "object",
     "description": "{requirement} or {tsm, clause}",
     "properties": {
      "requirement": {
       "type": "string"
      },
      "tsm": {
       "type": "string"
      },
      "clause": {
       "type": "string"
      }
     }
    },
    "line_item_revision": {
     "type": "integer",
     "minimum": 1
    },
    "state": {
     "enum": [
      "Kept",
      "Broken"
     ]
    },
    "bases": {
     "type": "array",
     "minItems": 1
    },
    "reason": {
     "type": "string",
     "description": "Required when Broken"
    },
    "author": {
     "type": "string",
     "description": "ref(Person)"
    },
    "approved_by": {
     "type": "string",
     "description": "Required when Broken: EDR line item - Design Lead of the FDPS lead Sub-system (or Sub-structure); TSM statement - Design Authority (6C.13)"
    },
    "approved_at": {
     "type": "string",
     "description": "datetime"
    },
    "status": {
     "enum": [
      "Current",
      "Flagged for re-confirmation"
     ]
    }
   },
   "if_broken_required": [
    "reason",
    "author",
    "approved_by",
    "approved_at"
   ]
  }
 },
 "type_changes": {
  "Requirement": {
   "add_fields": {
    "line_item_revision": {
     "type": "integer",
     "minimum": 1
    }
   },
   "links": {
    "Part of": {
     "target": "Requirement Document",
     "cardinality": "1"
    },
    "Allocated to": {
     "cardinality": "0..n",
     "note": "optional narrowing of the EDR Sub-system tag"
    }
   },
   "level_note": "level stays on each line item; an EDR may mix levels"
  },
  "TSM": {
   "statement_add_fields": {
    "revision": {
     "type": "integer",
     "minimum": 1
    }
   },
   "governs_forbid": [
    "SUB"
   ]
  },
  "Compliance Statement": {
   "rule": "only for Kept line items; statements_claimed must equal the Kept statements; 'no record' rule of 6B.11 removed"
  },
  "Lesson Learned": {
   "add_fields": {
    "design_type": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "description": "reg(DTY) or ALL"
     }
    },
    "sub_system": {
     "type": "array",
     "items": {
      "type": "string",
      "description": "reg(SUB)"
     }
    }
   },
   "add_required": [
    "design_type"
   ],
   "matching": "by tag only"
  },
  "Hub Page": {
   "applicable_design_types": "also on Sub-system and Sub-structure pages (route Sub-system > Design Type > TSM)",
   "owner_rule": "Sub-system pages show the Design Lead as owner",
   "add_fields": {
    "layout": {
     "type": "string",
     "description": "Tree page layout v1"
    }
   }
  },
  "FDPS": {
   "derived": [
    "line_item_maturity {reviewed,total,broken,unreviewed}"
   ],
   "gates": [
    "Stage C entry: unreviewed == 0",
    "Release gate: unreviewed == 0"
   ]
  }
 },
 "link_types": {
  "add": [
   "Part of (Requirement -> Requirement Document)",
   "Tagged to (Requirement Document -> Sub-system)",
   "Reviews line item (Line-item Review -> Requirement or TSM statement)"
  ]
 }
}